
# Full public-facing host Canvas should generate links for. Include the port
# only if visitors actually need it in the URL (e.g. CANVAS_DOMAIN=localhost:17380
# for direct access). Omit it when a reverse proxy (nginx/Apache) fronts this on
# the standard port, e.g. CANVAS_DOMAIN=saberestu.uaemex.mx
CANVAS_DOMAIN=localhost
# Must match whether that public-facing address is actually served over TLS.
# true/https when a reverse proxy terminates SSL in front of this stack.
CANVAS_SSL=false
CANVAS_PROTOCOL=http

# Internal Docker host port this stack listens on (used by docker-compose port
# mapping, and by a reverse proxy's ProxyPass/proxy_pass target). Not the same
# thing as the public port visitors use once behind a reverse proxy.
HOST_PORT=17380

POSTGRES_PASSWORD=changeme

# Cuenta admin que crea `db:initial_setup`
CANVAS_LMS_ADMIN_EMAIL=admin@example.com
CANVAS_LMS_ADMIN_PASSWORD=changeme
CANVAS_LMS_ACCOUNT_NAME="Mi Institución"

RCE_ECOSYSTEM_KEY=changeme
RCE_ECOSYSTEM_SECRET=changeme

STATSD_HOST=localhost
STATSD_PORT=8125

CANVAS_ENCRYPTION_KEY=changeme
CANVAS_JWT_KEY=changeme

FORCE_SSL=false
