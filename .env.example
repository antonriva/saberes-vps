# Copia este archivo a .env y ajusta los valores antes de levantar el stack.
# .env NO se commitea (ver .gitignore).

# Dominio/IP por el que vas a acceder (usa "localhost" en tu propia máquina,
# o la IP/dominio real del servidor Rocky Linux en un despliegue remoto).
# Esto queda grabado en canvas-lms/config/domain.yml y Canvas lo usa para
# armar todas sus URLs absolutas (redirects, links de notificaciones, etc.)
CANVAS_DOMAIN=localhost

# Puerto del host donde nginx va a escuchar (http://<CANVAS_DOMAIN>:<HOST_PORT>/)
HOST_PORT=17380

# Contraseña de Postgres (debe coincidir con canvas-config/database.yml.tmpl,
# que la toma de esta misma variable via envsubst en setup.sh)
POSTGRES_PASSWORD=changeme

# Cuenta admin que crea `db:initial_setup`
CANVAS_LMS_ADMIN_EMAIL=admin@example.com
CANVAS_LMS_ADMIN_PASSWORD=changeme
CANVAS_LMS_ACCOUNT_NAME="Mi Institución"

# Claves de ecosistema para el servicio RCE (Rich Content Editor).
# Deben medir EXACTAMENTE 32 bytes (setup.sh lo valida y aborta si no).
# Genera claves aleatorias con: openssl rand -hex 16
#
# OJO: estas mismas claves también se usan del lado de Canvas — se renderizan
# en canvas-lms/config/vault_contents.yml (canvas_security.encryption_secret/
# signing_secret) vía canvas-config/vault_contents.yml.tmpl. Es lo que le
# permite a Canvas firmar/encriptar un JWT que el RCE pueda verificar. Si
# cambias estas claves, el RCE deja de aceptar el JWT hasta que hagas
# `./setup.sh` de nuevo (o reinicies web/jobs) para que se vuelva a renderizar.
RCE_ECOSYSTEM_KEY=changeme
RCE_ECOSYSTEM_SECRET=changeme

# StatsD para métricas del RCE (opcional)
# Por defecto apunta a localhost:8125 (puerto estándar de StatsD)
# Si no tienes StatsD corriendo, dejalo como está (RCE ignorará errores de conexión)
STATSD_HOST=localhost
STATSD_PORT=8125
