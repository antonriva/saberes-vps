# Copia este archivo a .env 

CANVAS_DOMAIN=localhost

# Puerto del host donde nginx va a escuchar (http://<CANVAS_DOMAIN>:<HOST_PORT>/)
HOST_PORT=17380

POSTGRES_PASSWORD=changeme

# Cuenta admin que crea `db:initial_setup`
CANVAS_LMS_ADMIN_EMAIL=admin@example.com
CANVAS_LMS_ADMIN_PASSWORD=changeme
CANVAS_LMS_ACCOUNT_NAME="Mi Institución"

#Variables necesarias para RCE
RCE_ECOSYSTEM_KEY=changeme
RCE_ECOSYSTEM_SECRET=changeme

STATSD_HOST=localhost
STATSD_PORT=8125

# Secretos de canvas-config/security.yml.tmpl (bloque production).
# encryption_key: string aleatorio de al menos 20 caracteres.
# jwt_encryption_keys: string aleatorio de exactamente 64 caracteres.
# Genera ambos con: openssl rand -hex 32
CANVAS_ENCRYPTION_KEY=changeme
CANVAS_JWT_KEY=changeme

# En false mientras no esté confirmado que Apache está terminando TLS y
# reenviando X-Forwarded-Proto: https hacia este stack. Rails marca las
# cookies como Secure y el navegador las descarta sobre HTTP, rompiendo la
# sesión. Poner en true una vez confirmado.
FORCE_SSL=false
